+def _awaiting_human_task_ids(conn: sqlite3.Connection) -> set[str]:
+    """Ids of blocked factory workflow roots that wait for a human decision rather than failed.
+
+    Two cases: a project paused for plan approval (``awaiting`` set, no ``terminal`` outcome) and a
+    workflow stopped in ``human_review``. Boards without the factory tables return an empty set.
+    """
+    ids: set[str] = set()
+    try:
+        for row in conn.execute("SELECT root_id FROM factory_workflow_roots WHERE phase = 'human_review'"):
+            ids.add(row[0])
+        for row in conn.execute("SELECT root_id, document FROM factory_project_execution"):
+            try:
+                doc = json.loads(row[1])
+            except (TypeError, ValueError):
+                continue
+            if isinstance(doc, dict) and doc.get("awaiting") and not doc.get("terminal"):
+                ids.add(row[0])
+    except sqlite3.Error:
+        return set()
+    return ids
+
 
