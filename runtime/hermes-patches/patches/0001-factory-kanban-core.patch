+        "SELECT p.id, p.status FROM task_links l "
+        "JOIN tasks p ON p.id = l.parent_id "
+        "WHERE l.child_id = ? AND p.status NOT IN ('done', 'archived') "
+        "ORDER BY p.id", (task_id,),
+    ).fetchall()
+    return [(row["id"], row["status"]) for row in rows]
diff --git a/hermes_cli/kanban_db_mutation_guard.py b/hermes_cli/kanban_db_mutation_guard.py
new file mode 100644
index 00000000000..0e80388e0ba
--- /dev/null
+++ b/hermes_cli/kanban_db_mutation_guard.py
@@ -0,0 +1,39 @@
+"""Synchronous plugin vetoes inside the owning board write transaction."""
+import inspect
+
+GUARD_VERSION = 1
+
+
+def register_policy(conn, task_id, policy):
+    conn.execute("CREATE TABLE IF NOT EXISTS kanban_task_policies(task_id TEXT NOT NULL, policy TEXT NOT NULL, PRIMARY KEY(task_id,policy))")
+    conn.execute("INSERT OR IGNORE INTO kanban_task_policies VALUES(?,?)", (task_id,policy))
+
+
+def guard_mutation(conn, operation, task_id, proposed):
+    from hermes_cli.plugins import iter_hook_callbacks
+    from hermes_cli.kanban_db import get_current_board
+
+    path = next(row[2] for row in conn.execute('PRAGMA database_list') if row[1] == 'main')
+    payload = dict(conn=conn, operation=operation, task_id=task_id,
+                   proposed=proposed, board=proposed.get('board') or get_current_board(), board_path=path)
+    acknowledged = set()
+    for callback in iter_hook_callbacks('before_kanban_task_mutation'):
+        signature = inspect.signature(callback)
+        kwargs = payload if any(p.kind == p.VAR_KEYWORD for p in signature.parameters.values()) else {
+            key: value for key, value in payload.items() if key in signature.parameters}
+        result = callback(**kwargs)
+        if isinstance(result,str):
+            acknowledged.add(result)
+        if inspect.isawaitable(result):
+            if inspect.iscoroutine(result):
+                result.close()
+            raise ValueError('Task mutation hooks must be synchronous')
+
+    if conn.execute("SELECT 1 FROM sqlite_master WHERE name='kanban_task_policies'").fetchone():
+        ids = [task_id, '*'] if operation == 'created' else [task_id]
+        if proposed.get('parent_id'):
+            ids.append(proposed['parent_id'])
+        placeholders = ','.join('?' for _ in ids)
+        required = {row[0] for row in conn.execute(f'SELECT policy FROM kanban_task_policies WHERE task_id IN ({placeholders})', ids)}
+        if required - acknowledged:
+            raise ValueError('Required task policy consumer is unavailable; restore enforcement before modifying this task')
diff --git a/hermes_cli/kanban_db_task_creation.py b/hermes_cli/kanban_db_task_creation.py
new file mode 100644
index 00000000000..e1807da96b1
--- /dev/null
+++ b/hermes_cli/kanban_db_task_creation.py
@@ -0,0 +1,34 @@
+"""Synchronous creation observers before a task becomes eligible to dispatch."""
+import inspect
+
+
+def existing_task(conn, key):
+    if not key:
+        return None
+    row = conn.execute("SELECT id FROM tasks WHERE idempotency_key=? AND (status != 'archived' OR ? LIKE 'factory-submit-%' OR ? LIKE 'intake-%') ORDER BY created_at DESC LIMIT 1", (key, key, key)).fetchone()
+    return row['id'] if row else None
+
+
+def prepare_creation(conn, fields):
+    from hermes_cli.plugins import has_hook, iter_hook_callbacks
+
+    existing = existing_task(conn, fields['idempotency_key'])
+    if existing:
+        return existing
+    if not has_hook('before_kanban_task_create'):
+        return None
+    task = {key: fields.get(key) for key in ('title', 'body', 'assignee', 'created_by', 'idempotency_key',
+            'model_override', 'provider_override', 'reasoning_effort', 'creator_task_id')}
+    task.update(id=fields['task_id'], skills=fields['skills_list'], status=fields['task_status'])
+    path = next(row[2] for row in conn.execute('PRAGMA database_list') if row[1] == 'main')
+    payload = dict(conn=conn, task=task, board_path=path, board=fields.get('board'))
+    for callback in iter_hook_callbacks('before_kanban_task_create'):
+        signature = inspect.signature(callback)
+        kwargs = payload if any(p.kind == p.VAR_KEYWORD for p in signature.parameters.values()) else {
+            key: value for key, value in payload.items() if key in signature.parameters}
+        result = callback(**kwargs)
+        if inspect.isawaitable(result):
+            if inspect.iscoroutine(result):
+                result.close()
+            raise ValueError('Task creation hooks must be synchronous')
+    return None
