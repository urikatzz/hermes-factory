+import unittest
+from factory_dashboard.workflow_handoffs import normalize_handoff
+from factory_dashboard.workflow_gate import evaluate_cycle
+
+
+def result(kind='implement', verdict=None, **changes):
+    verdict = verdict or {'prepare':'DONE','implement':'DONE','repair':'DONE','review':'NO_BLOCKING_FINDINGS','verify':'PASS'}[kind]
+    stage = dict(root_id='t_root',stage_key=kind,kind=kind,cycle=0,profile='worker',evidence_retry=0)
+    metadata = dict(contract='factory-worker/v2', workflow_contract='factory-workflow/v1', root='t_root',stage_key=kind,stage=kind,cycle=1,verdict=verdict,
+                    manifest_sha12='123456abcdef',ac_ids=['AC1'],ac_results={'AC1':'pass'},findings=[],artifacts=['/evidence/report.md','/evidence/src-123456abcdef.tgz'], release_audit='PASS',snapshot='/evidence/source.tgz',publish_commands=['manual command'])
+    metadata.update(changes)
+    run = dict(id=1,task_id='t_stage',profile='worker',claim_lock='owned',status='done',outcome='completed',summary=f'VERDICT={verdict} STAGE={kind} CYCLE=1 MANIFEST={metadata["manifest_sha12"]}',metadata=metadata)
+    return normalize_handoff(dict(id='t_stage',status='done',current_run_id=1),run,stage)
+
+
+class WorkflowGateTests(unittest.TestCase):
+    def decide(self, writer=None, readers=None, repairs=0, maximum=3, previous=None, context=None):
+        return evaluate_cycle(writer or result(), readers or [result('review'),result('verify')], previous, maximum, repairs, context or {})
+
+    def test_same_manifest_and_acceptance_required(self):
+        self.assertEqual('pass', self.decide().decision)
+        self.assertEqual('human_review',self.decide(readers=[result('review',manifest_sha12='abcdef123456'),result('verify')]).decision)
+        self.assertEqual('human_review',self.decide(readers=[result('verify',ac_results={})]).decision)
+        self.assertEqual('human_review',self.decide(readers=[result('verify',release_audit='unknown')]).decision)
+
+    def test_findings_and_repair_limits(self):
+        for severity,ac,expected in [('BLOCKER','-','repair'),('HIGH','-','repair'),('MEDIUM','AC1','repair'),('MEDIUM','-','pass'),('LOW','-','pass')]:
+            readers=[result('review',findings=[f'F1|{severity}|{ac}|a.py:1|problem']),result('verify')]
+            self.assertEqual(expected,self.decide(readers=readers).decision)
+        failures=[result('review',verdict='CHANGES_REQUIRED', findings=['F1|HIGH|-|a:1|bug']),result('verify')]
+        self.assertEqual('human_review',self.decide(readers=failures,maximum=0).decision)
+        self.assertEqual('human_review',self.decide(readers=failures,repairs=3).decision)
+        self.assertEqual('repair',self.decide(readers=failures,repairs=2).decision)
+        self.assertEqual('repair',self.decide(readers=[result('verify',findings_truncated=1)]).decision)
+
+    def test_environment_no_progress_and_blocked_writer(self):
+        self.assertEqual('blocked',self.decide(writer=result(verdict='BLOCKED',blocked_reason='tool unavailable')).decision)
+        self.assertEqual('human_review',self.decide(readers=[result('verify',ac_results={'AC1':'unverified:environment'})]).decision)
+        self.assertEqual('human_review',self.decide(readers=[result('verify',blocked_tools=[{'needed_for':'security'}])]).decision)
+        self.assertEqual('human_review',self.decide(readers=[result('verify',verdict='FAIL',preexisting=True)]).decision)
+        self.assertEqual('repair',self.decide(readers=[result('verify',ac_results={'AC1':'unverified:code'})]).decision)
